{
  "name": "multi-provider-ai-gateway",
  "version": "1.0.0",
  "description": "Provider-neutral AI gateway resilience primitives",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "docs",
    "examples",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "clean:coverage": "rm -rf coverage",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:coverage": "npm run clean:coverage && tsc -p tsconfig.coverage.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "verify": "npm run check && npm test",
    "coverage:check": "npm run build:coverage && node scripts/check-coverage.mjs",
    "demo:observability": "npm run build && node examples/observability.mjs",
    "demo:dashboard": "npm run build && node examples/dashboard.mjs",
    "demo:benchmark": "npm run build && node examples/strategy-benchmark.mjs",
    "demo:security": "npm run build && node examples/security.mjs",
    "demo:integration": "npm run build && node examples/rag-agent-integration.mjs",
    "pack:check": "npm run build && node scripts/check-package.mjs",
    "release:check": "node scripts/check-release.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.2"
  }
}
